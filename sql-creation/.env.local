# =============================================================================
# PROYECTO DELFOS — Capa Oro
# .env.local : Variables de entorno para desarrollo local
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=delfos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=delfos_dev_pass
POSTGRES_HOST=localhost          
POSTGRES_PORT=5432

# ─── Notify Listener ──────────────────────────────────────────────────────────
REPORTING_URL=http://localhost:8000/anomaly

NOTIFY_CHANNEL=anomaly_channel
HTTP_TIMEOUT=5
HTTP_MAX_RETRIES=3
RECONNECT_DELAY=5

# ─── Reportes / Notificaciones ────────────────
TELEGRAM_BOT_TOKEN=undefined_token
TELEGRAM_CHAT_ID=undefined_chat_id
DISCORD_URL_WEBHOOK=undefined_url

# ─── Polymarket ───────────────────────────────────────────────────────────────
POLYMARKET_BASE_URL=https://polymarket.com
